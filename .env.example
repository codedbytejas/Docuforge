# Copy to .env (never commit it). The key stays on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------------
# Rate Limiting & Quota Protection Configuration
# All limits are configurable with zero hardcoded thresholds.
# ---------------------------------------------------------------------------

# Master toggle for rate limiting (set false for testing/local dev without limits)
RL_ENABLED=true

# Per-user generation limits (tracked against signed HttpOnly cookie + socket IP)
RL_GENERATIONS_PER_HOUR=5
RL_GENERATIONS_PER_DAY=15

# Per-user section regeneration limit (cheaper than full analysis)
RL_REGENERATIONS_PER_HOUR=15

# Maximum concurrent running generation jobs per user
RL_MAX_CONCURRENT_JOBS_PER_USER=1

# Global app-wide Gemini budget guard (guards against whole-app quota exhaustion)
RL_GLOBAL_REQUESTS_PER_MINUTE=15
RL_GLOBAL_DAILY_REQUESTS=1500

# File upload frequency and code payload constraints
RL_UPLOADS_PER_MINUTE=10
RL_MAX_INPUT_CHARS=150000

# Proxy Trust Flag
# When false (default), strictly uses socket address request.client.host.
# Set true ONLY behind a trusted reverse proxy (e.g. Nginx, Cloudflare) to read X-Forwarded-For.
TRUSTED_PROXY=false

# Secret key used for signing anonymous client identity cookies (defaults to GEMINI_API_KEY if unset)
RL_SECRET_KEY=docuforge-secure-client-salt-default-key
